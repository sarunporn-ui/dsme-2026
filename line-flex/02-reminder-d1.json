{
  "type": "flex",
  "altText": "พรุ่งนี้เจอกันที่ Workshop LINE AI นะ 📅",
  "contents": {
    "type": "bubble",
    "size": "mega",
    "hero": {
      "type": "image",
      "url": "{{imgBase}}/line-flex/img/hero-reminder.jpg",
      "size": "full",
      "aspectRatio": "1040:540",
      "aspectMode": "cover"
    },
    "body": {
      "type": "box",
      "layout": "vertical",
      "spacing": "md",
      "paddingAll": "20px",
      "backgroundColor": "#0F172A",
      "contents": [
        {
          "type": "text",
          "text": "Workshop LINE AI เลขาส่วนตัวเจ้าของธุรกิจ",
          "wrap": true,
          "size": "md",
          "weight": "bold",
          "color": "#E6EEFF"
        },
        {
          "type": "box",
          "layout": "vertical",
          "spacing": "sm",
          "backgroundColor": "#16203C",
          "cornerRadius": "14px",
          "paddingAll": "16px",
          "borderWidth": "2px",
          "borderColor": "#3A4870",
          "contents": [
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "md",
              "contents": [
                {
                  "type": "text",
                  "text": "วัน",
                  "wrap": true,
                  "size": "sm",
                  "color": "#B6C2D9",
                  "flex": 3
                },
                {
                  "type": "text",
                  "text": "{{date}}",
                  "wrap": true,
                  "size": "sm",
                  "color": "#E6EEFF",
                  "weight": "bold",
                  "flex": 7
                }
              ]
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "md",
              "contents": [
                {
                  "type": "text",
                  "text": "เวลา",
                  "wrap": true,
                  "size": "sm",
                  "color": "#B6C2D9",
                  "flex": 3
                },
                {
                  "type": "text",
                  "text": "{{time}}",
                  "wrap": true,
                  "size": "sm",
                  "color": "#E6EEFF",
                  "weight": "bold",
                  "flex": 7
                }
              ]
            },
            {
              "type": "box",
              "layout": "baseline",
              "spacing": "md",
              "contents": [
                {
                  "type": "text",
                  "text": "ที่ไหน",
                  "wrap": true,
                  "size": "sm",
                  "color": "#B6C2D9",
                  "flex": 3
                },
                {
                  "type": "text",
                  "text": "{{location}}",
                  "wrap": true,
                  "size": "sm",
                  "color": "#E6EEFF",
                  "weight": "bold",
                  "flex": 7
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "เตรียมตัวก่อนเรียน",
          "wrap": true,
          "size": "sm",
          "weight": "bold",
          "color": "#FF7A3D",
          "margin": "lg"
        },
        {
          "type": "text",
          "text": "✅ มือถือที่มี LINE + ชาร์จแบตให้เต็ม\n✅ งานที่อยากให้ AI ช่วย: {{aiGoal}}",
          "wrap": true,
          "size": "sm",
          "color": "#E6EEFF"
        }
      ]
    },
    "footer": {
      "type": "box",
      "layout": "vertical",
      "spacing": "sm",
      "paddingAll": "16px",
      "backgroundColor": "#0F172A",
      "contents": [
        {
          "type": "button",
          "style": "primary",
          "color": "#2563FF",
          "height": "md",
          "action": {
            "label": "เพิ่มลงปฏิทิน",
            "type": "uri",
            "uri": "{{calendarUrl}}"
          }
        },
        {
          "type": "button",
          "style": "secondary",
          "color": "#DCE6FF",
          "height": "md",
          "action": {
            "label": "ขอเลื่อน / มาไม่ได้",
            "type": "message",
            "text": "ขอเลื่อน Workshop LINE AI"
          }
        },
        {
          "type": "text",
          "text": "TOGREATER · AI for Entrepreneur",
          "wrap": true,
          "size": "xxs",
          "color": "#B6C2D9",
          "align": "center",
          "margin": "md"
        }
      ]
    },
    "styles": {
      "footer": {
        "separator": false
      }
    }
  }
}